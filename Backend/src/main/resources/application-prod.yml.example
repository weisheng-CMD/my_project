# ==================== 生产环境配置 ====================
# 使用方法：复制此文件为 application-prod.yml，填入真实的生产数据库信息
# 启动时指定：--spring.profiles.active=prod
# 或者设置环境变量：DB_URL、DB_USERNAME、DB_PASSWORD

spring:
  datasource:
    url: jdbc:mysql://your_prod_host:3306/my_project?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai
    username: your_prod_username
    password: your_prod_password
